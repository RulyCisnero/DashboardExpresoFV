{
  "compilerOptions": {
    "target": "ES2020",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "resolveJsonModule": true,

    "strict": true,
    "forceConsistentCasingInFileNames": true,

    "types": ["node"],

    "outDir": "dist",
    "rootDir": "src",

    "noEmit": false
  },
  "include": ["src"],
  "exclude": ["node_modules"]
}